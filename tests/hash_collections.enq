import core::dict::Dict
import core::set::Set
fn main() -> u32 {
    let mut values = Dict[usize, usize]::with_capacity(0)
    let shared = values
    for i in 0..4096 {
        values.insert(i, i * 2)
    }
    for i in 0..3072 {
        if values.remove(i).unwrap_or(99999) != i * 2 {
            ret 1
        }
    }
    if shared.len() != 1024 {
        ret 2
    }
    let keys = values.keys()
    for i in 0..keys.len() {
        if keys.get(i).unwrap_or(0) != i + 3072 {
            ret 3
        }
    }
    values.reserve(8192)
    for i in 0..3072 {
        values.insert(i, i)
    }
    if shared.keys().get(1024).unwrap_or(99999) != 0 {
        ret 4
    }
    let mut independent = values.clone()
    independent.clear()
    if independent.len() != 0 || shared.len() != 4096 {
        ret 5
    }
    let mut set = Set[str]::new()
    if !set.insert("one") || set.insert("one") || !set.remove("one") {
        ret 6
    }
    ret 0
}
